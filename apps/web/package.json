{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "size": "node scripts/check-size-budgets.mjs",
    "perf": "node scripts/perf-harness.mjs",
    "perf:check": "node scripts/perf-harness.mjs --check",
    "perf:check:server": "node scripts/perf-harness.mjs --check --require-runtime",
    "budget:update": "node scripts/perf-harness.mjs --update",
    "lhci": "pnpm dlx @lhci/cli@0.15.1 autorun --config=lighthouserconfig.js",
    "start": "next start",
    "lint": "eslint .",
    "size": "size-limit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test e2e/settings-persistence.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "openapi:generate": "pnpm exec tsc scripts/generate-openapi.ts --module commonjs --target es2022 --rootDir . --outDir build/openapi --esModuleInterop --skipLibCheck --types node && node build/openapi/generate-openapi.js",
    "openapi:update": "pnpm run openapi:generate",
    "openapi:check": "pnpm run openapi:generate -- --check"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.75.2",
    "@uploadthing/react": "^7.3.3",
    "@upstash/redis": "^1.38.4",
    "@vercel/kv": "^3.0.0",
    "next": "16.3.5",
    "nodemailer": "^6.10.1",
    "react": "19.2.3",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "uploadthing": "^7.7.4",
    "yaml": "2.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "1.61.1",
    "@size-limit/file": "^14.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26",
    "@types/nodemailer": "^6.4.19",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-istanbul": "^2.1.8",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "size-limit": "^11.2.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
