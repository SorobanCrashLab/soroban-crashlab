[
  {
    "name": "route-group: runtime-bootstrap",
    "path": [
      ".next/static/chunks/turbopack-*.js"
    ],
    "gzip": true,
    "limit": "12 kB"
  },
  {
    "name": "route-group: shared-styles",
    "path": [
      ".next/static/chunks/*.css"
    ],
    "gzip": true,
    "limit": "40 kB"
  },
  {
    "name": "route-group: static-bundles",
    "path": [
      ".next/static/chunks/*.js"
    ],
    "gzip": true,
    "limit": "1300 kB"
  }
]
