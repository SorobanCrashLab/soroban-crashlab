# Backend API Base URL (build-time, browser bundle)
# Classification: public
NEXT_PUBLIC_API_URL=

# Application URL (operator contract for server-side links)
# Classification: public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mock data mode when no backend is configured
# Classification: public
NEXT_PUBLIC_ENABLE_MOCK_DATA=true

# Optional public GitHub OAuth client id
# Classification: public
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# Optional default repo shown in GitHub Actions UI
# Classification: public
NEXT_PUBLIC_GITHUB_REPOSITORY=

# Sentry browser/server DSN (validated at boot; invalid = Sentry off)
# Classification: public
NEXT_PUBLIC_SENTRY_DSN=
# Sentry environment name (default: Vercel env, else NODE_ENV)
# Classification: public
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Set automatically by next.config.ts at build time — leave empty
# Classification: public
NEXT_PUBLIC_SENTRY_RELEASE=

# Discord Integration — Classification: secret
DISCORD_WEBHOOK_URL=

# Slack Integration — Classification: secret
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=

# Webhook API Authentication — Classification: secret
# When set, all webhook endpoints require Authorization: Bearer <key>
# When unset, endpoints return 503 unless CRASHLAB_ALLOW_UNAUTHENTICATED_WEBHOOKS=1 (local dev only)
CRASHLAB_WEBHOOK_API_KEY=
# Escape hatch for local development ONLY — set to '1' to allow unauthenticated webhook access
# WARNING: Do not enable in production or preview deployments!
CRASHLAB_ALLOW_UNAUTHENTICATED_WEBHOOKS=

# Cron tick endpoint — Classification: secret
CRASHLAB_CRON_SECRET=

# Metrics scrape bearer — Classification: secret
# When set, metrics endpoints require Authorization: Bearer <token>
# When unset, endpoints return 503 unless CRASHLAB_ALLOW_UNAUTHENTICATED_METRICS=1 (local dev only)
CRASHLAB_METRICS_SCRAPE_TOKEN=
# Escape hatch for local development ONLY — set to '1' to allow unauthenticated metrics access
# WARNING: Do not enable in production or preview deployments!
CRASHLAB_ALLOW_UNAUTHENTICATED_METRICS=

# API token store tuning — Classification: server-only
CRASHLAB_API_TOKEN_TTL_DAYS=90
CRASHLAB_API_TOKEN_ROTATION_GRACE_HOURS=24

# Rate limiting — Classification: server-only
CRASHLAB_API_RATE_LIMIT_WINDOW_MS=60000
CRASHLAB_API_RATE_LIMIT_MAX_REQUESTS=120

# Local artifact directory — Classification: server-only
CRASHLAB_ARTIFACT_DIR=

# Artifact storage driver (in-memory default; set s3 to enable)
# Classification: server-only
CRASHLAB_STORAGE_DRIVER=
CRASHLAB_S3_ENDPOINT=
CRASHLAB_S3_REGION=
CRASHLAB_S3_BUCKET=
# Classification: secret
CRASHLAB_S3_ACCESS_KEY_ID=
CRASHLAB_S3_SECRET_ACCESS_KEY=
CRASHLAB_S3_SESSION_TOKEN=

# Role-Based Access Control
# Roles are resolved from a persisted role store keyed by an authenticated
# principal (an API token id, or a GitHub login). They are never read from the
# request. Unauthenticated callers get the lowest role.
#
# HMAC signing secret for the GitHub OAuth server-side session cookie.
# Browser sessions require shared Upstash Redis (KV_REST_API_URL/TOKEN); when
# that store is unavailable, sessions are not issued or verified.
CRASHLAB_GITHUB_SESSION_SECRET=
# Maximum browser cookie lifetime in seconds (capped at 12 hours; idle timeout is 30 minutes).
CRASHLAB_GITHUB_SESSION_TTL_SECONDS=43200
# Age-based retention for the RBAC authorization audit log.
CRASHLAB_RBAC_AUDIT_RETENTION_DAYS=90
# Hard cap on retained RBAC audit entries and role-change entries.
CRASHLAB_RBAC_AUDIT_MAX_ENTRIES=10000
CRASHLAB_RBAC_ROLE_AUDIT_MAX_ENTRIES=1000

# Jira Integration
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Linear Integration — Classification: secret
LINEAR_API_KEY=

# GitHub Actions Integration — Classification: secret
GITHUB_ACTIONS_TOKEN=

# Grafana annotations — Classification: secret (token)
GRAFANA_BASE_URL=
GRAFANA_API_TOKEN=

# PagerDuty — Classification: secret
PAGERDUTY_INTEGRATION_KEY=

# PagerDuty v3 webhook signing secret (ack/resolve sync) — Classification: secret
PAGERDUTY_WEBHOOK_SECRET=

# Alert routing (#1892) — see docs/ops/oncall.md
# Empty = ../../ops/alert-policies.yml relative to apps/web
ALERT_POLICY_PATH=
ALERT_SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=

# OIDC external auth (#1893) — see docs/adr/0009-oidc-role-mapping.md
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
OIDC_CLOCK_SKEW_SECONDS=60
OIDC_ROLE_MAPPING=
# HMAC signing secret for opaque server-side OIDC sessions; requires shared Upstash Redis.
CRASHLAB_OIDC_SESSION_SECRET=

# Tenancy (#1894) — JSON memberships; unset = single-tenant default org
CRASHLAB_TENANCY_MEMBERSHIPS=

# Audit checkpoint signing key (#1895) — Classification: secret
CRASHLAB_AUDIT_CHECKPOINT_KEY=

# Datadog — Classification: server-only
DATADOG_ENABLED=false
DATADOG_AGENT_HOST=localhost
DATADOG_AGENT_PORT=8125

# Request Size Limits (bytes) — Classification: server-only
MAX_REQUEST_SIZE=10485760
MAX_JSON_SIZE=1048576
MAX_FORM_DATA_SIZE=1048576

# Database Configuration — Classification: server-only (URLs may be secret)
DATABASE_TYPE=sqlite
SQLITE_PATH=.data/crashlab.db
DATABASE_URL=
POSTGRES_URL_NON_POOLING=
DB_POOL_MAX=10

# Upstream API overrides — Classification: server-only
RUNS_API_URL=
ISSUES_API_URL=

# Notifications feed — Classification: server-only
NOTIFICATIONS_FEED_ENABLED=true
NOTIFICATIONS_FEED_URL=
NOTIFICATIONS_API_URL=
NOTIFICATION_RETENTION_DAYS=90
WEBHOOK_HISTORY_RETENTION_DAYS=30

# Prometheus health probes — Classification: server-only
PROMETHEUS_ENDPOINT=http://localhost:9090
PROMETHEUS_HEALTH_PATH=/-/healthy
PROMETHEUS_TIMEOUT_MS=5000

# Structured Logging — Classification: server-only
SERVICE_NAME=soroban-crashlab
CLOUDWATCH_ENABLED=false
CLOUDWATCH_LOG_GROUP=/soroban/crashlab
CLOUDWATCH_LOG_STREAM=default
AWS_REGION=us-east-1

# Upstash Redis — Classification: secret
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Uploadthing — Classification: secret (SDK-consumed)
UPLOADTHING_SECRET=

# Sentry Build-Time Source Map Upload — Classification: secret
# DO NOT commit real tokens.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_RELEASE=
# Upload hidden source maps and create the release (off until keys exist)
# Classification: server-only
SENTRY_UPLOAD_SOURCEMAPS=false
# Same-origin tunnel for ad-blocked clients, e.g. /monitoring
# Classification: server-only
SENTRY_TUNNEL_ROUTE=

# CI regression results ingest (#1890) — Classification: server-only
# owner/repo allowed to post results; unset accepts any repository
CRASHLAB_CI_REPOSITORY=

# Campaign capacity quotas (#1904) — Classification: server-only
# Empty = unlimited. Global scope until tenancy lands. See docs/ops/capacity.md
CRASHLAB_QUOTA_CONCURRENT_WORKERS=
CRASHLAB_QUOTA_SEEDS_PER_DAY=
CRASHLAB_QUOTA_RPC_CALLS_PER_DAY=
CRASHLAB_QUOTA_STORAGE_GB=
# Scheduling windows (UTC), e.g. deep=00:00-06:00,nightly=20:00-08:00
CRASHLAB_SCHEDULING_WINDOWS=
