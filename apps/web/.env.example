# CrashLab Web Environment Variables

# Database (future use - currently in-memory)
# DATABASE_URL=

# Session
# SESSION_SECRET=

# API Keys (external services)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Export/Download Signed URLs
# DOWNLOAD_SIGNING_SECRET=your-secret-key-here
# DOWNLOAD_EXPIRY_SECONDS=3600

# SSE/Real-time
# SSE_HEARTBEAT_INTERVAL=30000

# Feature Flags
# ENABLE_DEMO_MODE=true
# ENABLE_TELEMETRY=false

# Onboarding
# ONBOARDING_SAMPLE_DATA_ENABLED=true
