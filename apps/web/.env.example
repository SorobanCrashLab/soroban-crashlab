# Backend API Base URL (build-time, browser bundle)
# The browser talks to this base instead of the Next.js /api/* routes. Inlined
# into the client at BUILD time (NEXT_PUBLIC_*), so set it when building. Leave
# empty to use same-origin /api/* routes (default / mock-data mode).
NEXT_PUBLIC_API_URL=

# Discord Integration
DISCORD_WEBHOOK_URL=

# Slack Integration (threaded run notifications; requires a Slack app with
# the chat:write bot scope, since incoming webhooks can't return the ts
# needed to thread replies)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Webhook API Authentication
# When set, all /api/webhooks requests must include Authorization: Bearer <key>
# Leave empty to keep the endpoint unauthenticated.
CRASHLAB_WEBHOOK_API_KEY=

# Jira Integration
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Linear Integration
LINEAR_API_KEY=

# GitHub Actions Integration
# Fine-grained token with Actions read/write access to the configured repository.
GITHUB_ACTIONS_TOKEN=
# Optional default shown by the dashboard, e.g. SorobanCrashLab/soroban-crashlab
NEXT_PUBLIC_GITHUB_REPOSITORY=

# Datadog Integration
DATADOG_ENABLED=false
DATADOG_AGENT_HOST=localhost
DATADOG_AGENT_PORT=8125

# Request Size Limits (in bytes)
# Default: 10MB, 5MB JSON, 100MB form data
MAX_REQUEST_SIZE=10485760
MAX_JSON_SIZE=5242880
MAX_FORM_DATA_SIZE=104857600

# Database Configuration
# Type: sqlite | postgres | vercel-postgres
DATABASE_TYPE=sqlite
SQLITE_PATH=.data/crashlab.db
# For PostgreSQL or Vercel Postgres
DATABASE_URL=
POSTGRES_URL_NON_POOLING=
DB_POOL_MAX=10

# Structured Logging
SERVICE_NAME=soroban-crashlab
CLOUDWATCH_ENABLED=false
CLOUDWATCH_LOG_GROUP=/soroban/crashlab
CLOUDWATCH_LOG_STREAM=default
AWS_REGION=us-east-1
