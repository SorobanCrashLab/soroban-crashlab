# Backend API Base URL (build-time, browser bundle)
# Classification: public
NEXT_PUBLIC_API_URL=

# Application URL (operator contract for server-side links)
# Classification: public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mock data mode when no backend is configured
# Classification: public
NEXT_PUBLIC_ENABLE_MOCK_DATA=true

# Optional public GitHub OAuth client id
# Classification: public
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# Optional default repo shown in GitHub Actions UI
# Classification: public
NEXT_PUBLIC_GITHUB_REPOSITORY=

# Sentry browser/server DSN
# Classification: public
NEXT_PUBLIC_SENTRY_DSN=

# Discord Integration — Classification: secret
DISCORD_WEBHOOK_URL=

# Slack Integration — Classification: secret
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=

# Webhook API Authentication — Classification: secret
CRASHLAB_WEBHOOK_API_KEY=

# Cron tick endpoint — Classification: secret
CRASHLAB_CRON_SECRET=

# Metrics scrape bearer — Classification: secret
CRASHLAB_METRICS_SCRAPE_TOKEN=

# API token store tuning — Classification: server-only
CRASHLAB_API_TOKEN_TTL_DAYS=90
CRASHLAB_API_TOKEN_ROTATION_GRACE_HOURS=24

# Rate limiting — Classification: server-only
CRASHLAB_API_RATE_LIMIT_WINDOW_MS=60000
CRASHLAB_API_RATE_LIMIT_MAX_REQUESTS=120

# Local artifact directory — Classification: server-only
CRASHLAB_ARTIFACT_DIR=

# Artifact storage driver (in-memory default; set s3 to enable)
# Classification: server-only
CRASHLAB_STORAGE_DRIVER=
CRASHLAB_S3_ENDPOINT=
CRASHLAB_S3_REGION=
CRASHLAB_S3_BUCKET=
# Classification: secret
CRASHLAB_S3_ACCESS_KEY_ID=
CRASHLAB_S3_SECRET_ACCESS_KEY=
CRASHLAB_S3_SESSION_TOKEN=

# Jira Integration — Classification: secret (token) / server-only (urls)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Linear Integration — Classification: secret
LINEAR_API_KEY=

# GitHub Actions Integration — Classification: secret
GITHUB_ACTIONS_TOKEN=

# Grafana annotations — Classification: secret (token)
GRAFANA_BASE_URL=
GRAFANA_API_TOKEN=

# PagerDuty — Classification: secret
PAGERDUTY_INTEGRATION_KEY=

# Datadog — Classification: server-only
DATADOG_ENABLED=false
DATADOG_AGENT_HOST=localhost
DATADOG_AGENT_PORT=8125

# Request Size Limits (bytes) — Classification: server-only
MAX_REQUEST_SIZE=10485760
MAX_JSON_SIZE=5242880
MAX_FORM_DATA_SIZE=104857600

# Database Configuration — Classification: server-only (URLs may be secret)
DATABASE_TYPE=sqlite
SQLITE_PATH=.data/crashlab.db
DATABASE_URL=
POSTGRES_URL_NON_POOLING=
DB_POOL_MAX=10

# Upstream API overrides — Classification: server-only
RUNS_API_URL=
ISSUES_API_URL=

# Notifications feed — Classification: server-only
NOTIFICATIONS_FEED_ENABLED=true
NOTIFICATIONS_FEED_URL=
NOTIFICATIONS_API_URL=
NOTIFICATION_RETENTION_DAYS=90
WEBHOOK_HISTORY_RETENTION_DAYS=30

# Prometheus health probes — Classification: server-only
PROMETHEUS_ENDPOINT=http://localhost:9090
PROMETHEUS_HEALTH_PATH=/-/healthy
PROMETHEUS_TIMEOUT_MS=5000

# Structured Logging — Classification: server-only
SERVICE_NAME=soroban-crashlab
CLOUDWATCH_ENABLED=false
CLOUDWATCH_LOG_GROUP=/soroban/crashlab
CLOUDWATCH_LOG_STREAM=default
AWS_REGION=us-east-1

# Upstash Redis — Classification: secret
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Uploadthing — Classification: secret (SDK-consumed)
UPLOADTHING_SECRET=

# Sentry Build-Time Source Map Upload — Classification: secret
# DO NOT commit real tokens.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_RELEASE=
