# Backend API Base URL (build-time, browser bundle)
# The browser talks to this base instead of the Next.js /api/* routes. Inlined
# into the client at BUILD time (NEXT_PUBLIC_*), so set it when building. Leave
# empty to use same-origin /api/* routes (default / mock-data mode).
NEXT_PUBLIC_API_URL=

# Discord Integration
DISCORD_WEBHOOK_URL=

# Slack Integration (threaded run notifications; requires a Slack app with
# the chat:write bot scope, since incoming webhooks can't return the ts
# needed to thread replies)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Webhook API Authentication
# When set, all /api/webhooks requests must include Authorization: Bearer <key>
# Leave empty to keep the endpoint unauthenticated.
CRASHLAB_WEBHOOK_API_KEY=

# Role-Based Access Control
# Roles are resolved from a persisted role store keyed by an authenticated
# principal (an API token id, or a GitHub login). They are never read from the
# request. Unauthenticated callers get the lowest role.
#
# HMAC signing secret for the GitHub OAuth session cookie. Leave empty to keep
# browser sessions unbound, in which case browser callers are anonymous.
CRASHLAB_GITHUB_SESSION_SECRET=
# GitHub session cookie lifetime, in seconds (default 7 days).
CRASHLAB_GITHUB_SESSION_TTL_SECONDS=604800
# Age-based retention for the RBAC authorization audit log.
CRASHLAB_RBAC_AUDIT_RETENTION_DAYS=90
# Hard cap on retained RBAC audit entries and role-change entries.
CRASHLAB_RBAC_AUDIT_MAX_ENTRIES=10000
CRASHLAB_RBAC_ROLE_AUDIT_MAX_ENTRIES=1000

# Jira Integration
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Linear Integration
LINEAR_API_KEY=

# GitHub Actions Integration
# Fine-grained token with Actions read/write access to the configured repository.
GITHUB_ACTIONS_TOKEN=
# Optional default shown by the dashboard, e.g. SorobanCrashLab/soroban-crashlab
NEXT_PUBLIC_GITHUB_REPOSITORY=

# Datadog Integration
DATADOG_ENABLED=false
DATADOG_AGENT_HOST=localhost
DATADOG_AGENT_PORT=8125

# Request Size Limits (in bytes)
# Default: 10MB, 5MB JSON, 100MB form data
MAX_REQUEST_SIZE=10485760
MAX_JSON_SIZE=5242880
MAX_FORM_DATA_SIZE=104857600

# Database Configuration
# Type: sqlite | postgres | vercel-postgres
DATABASE_TYPE=sqlite
SQLITE_PATH=.data/crashlab.db
# For PostgreSQL or Vercel Postgres
DATABASE_URL=
POSTGRES_URL_NON_POOLING=
DB_POOL_MAX=10

# Structured Logging
SERVICE_NAME=soroban-crashlab
CLOUDWATCH_ENABLED=false
CLOUDWATCH_LOG_GROUP=/soroban/crashlab
CLOUDWATCH_LOG_STREAM=default
AWS_REGION=us-east-1

# Upstash Redis (run + artifact metadata)
# Set these from Vercel Storage → Marketplace → Upstash
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Uploadthing (artifact file uploads)
# Get from uploadthing.com → dashboard → API Keys
UPLOADTHING_SECRET=

# Production flags
NEXT_PUBLIC_ENABLE_MOCK_DATA=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry Error Reporting & Observability
# Public DSN for browser and server runtime error reporting (safe for browser bundle)
NEXT_PUBLIC_SENTRY_DSN=

# Sentry Build-Time Source Map Upload & Release Tagging
# DO NOT commit real tokens to git! Wire via Vercel env vars and CI secrets.
# Token requires project:releases and org:read permissions.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional release name override (defaults to git commit SHA)
# SENTRY_RELEASE=

