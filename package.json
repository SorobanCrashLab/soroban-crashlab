{
  "name": "soroban-crashlab",
  "private": true,
  "packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4",
  "scripts": {
    "dev": "pnpm --dir apps/web run dev",
    "build": "pnpm --dir apps/web run build",
    "analyze": "pnpm --dir apps/web run analyze",
    "start": "pnpm --dir apps/web run start",
    "lint": "pnpm --dir apps/web run lint",
    "test": "pnpm --dir apps/web run test",
    "e2e": "pnpm --dir apps/web run e2e",
    "crashlab": "pnpm --dir tools/cli run build && node tools/cli/dist/index.js",
    "crashlab:dev": "tsx tools/cli/src/index.ts",
    "doctor": "pnpm crashlab doctor",
    "onboard": "pnpm crashlab onboard",
    "scaffold": "pnpm crashlab scaffold",
    "generate": "pnpm crashlab generate",
    "seed": "pnpm crashlab seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "workspace": {
      "catalog": {
        "typescript": "^5.9.3"
      }
    }
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
