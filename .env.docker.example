# ─────────────────────────────────────────────────────────────
# Docker Compose environment — copy to .env to use:
#   cp .env.docker.example .env
#   docker compose up
# ─────────────────────────────────────────────────────────────

# Node environment
NODE_ENV=development

# Enable file polling for hot reload inside the container
WATCHPACK_POLLING=true

# Use mock data (no external backend required)
NEXT_PUBLIC_ENABLE_MOCK_DATA=true

# ── Optional integrations (leave blank to disable) ──────────

# Discord
DISCORD_WEBHOOK_URL=

# Slack (requires a Slack app with chat:write bot scope)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Linear
LINEAR_API_KEY=

# GitHub Actions
GITHUB_ACTIONS_TOKEN=
NEXT_PUBLIC_GITHUB_REPOSITORY=

# Datadog
DATADOG_ENABLED=false
DATADOG_AGENT_HOST=localhost
DATADOG_AGENT_PORT=8125

# Request Size Limits (in bytes)
MAX_REQUEST_SIZE=10485760
MAX_JSON_SIZE=5242880
MAX_FORM_DATA_SIZE=104857600

# Database Configuration (SQLite for local development)
DATABASE_TYPE=sqlite
SQLITE_PATH=.data/crashlab.db

# Structured Logging
SERVICE_NAME=soroban-crashlab
CLOUDWATCH_ENABLED=false
